{
  "name": "yii2-kamancms-frontend",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./frontend/web/css/src/app.css -o ./frontend/web/css/app.css --watch",
    "build": "tailwindcss -i ./frontend/web/css/src/app.css -o ./frontend/web/css/app.css --minify",
    "check:css": "node scripts/check-css-duplicates.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
